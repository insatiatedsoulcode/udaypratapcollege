# Production Environment Variables Template for Uday Pratap College
# Copy this file to .env.production on your EC2 instance and update with your actual values

# Application Environment
NODE_ENV=production
PORT=3000

# Database Configuration
DATABASE_URL=sqlite:./data/college.db

# Email Configuration (Update with your SMTP details)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
ADMIN_EMAIL=admin@udaypratapcollege.com

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Domain Configuration
DOMAIN_NAME=udaypratapcollege.com
SITE_URL=https://udaypratapcollege.com

# Security Settings
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=86400

# File Upload Settings
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Monitoring and Logging
LOG_LEVEL=info
ENABLE_ANALYTICS=true

# Rate Limiting
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX_REQUESTS=100

# CORS Settings
CORS_ORIGIN=https://udaypratapcollege.com
CORS_CREDENTIALS=true
